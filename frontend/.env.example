# ============================================================================
# STARMOND TECHNOLOGY LIMITED — frontend PUBLIC build configuration
#
# Copy to `.env` and fill in. Then run:
#     node tools/write-config.mjs
# which writes assets/js/config.js (the file the browser actually reads).
#
# A browser CANNOT read this file. Only the values below are injected, and they
# are all PUBLIC. NEVER put a secret here: no Paystack secret key, no Django
# SECRET_KEY, no database credentials, no private API token.
# ============================================================================

# Public REST root of the Django backend.
# Relative (recommended): reverse-proxy /api to Django on the same origin.
# Absolute: https://api.your-domain.example/api
API_BASE_URL=/api

# Canonical public origin of this storefront (no trailing slash).
# Used for canonical URLs, Open Graph, sitemap generation and pre-rendering.
SITE_URL=https://your-store-domain.example

# Authentication strategy the backend exposes: session | jwt
# session = DRF session cookie + CSRF (httpOnly, safest default)
# jwt     = Bearer access token in memory + httpOnly refresh cookie
AUTH_MODE=session

# Django CSRF cookie/header names (defaults shown).
CSRF_COOKIE_NAME=csrftoken
CSRF_HEADER_NAME=X-CSRFToken

# Network behaviour
REQUEST_TIMEOUT_MS=20000
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_MS=400
PUBLIC_CACHE_TTL_MS=60000
SEARCH_DEBOUNCE_MS=300

# Locale / currency presentation (the API remains authoritative on amounts)
CURRENCY=NGN
LOCALE=en-NG

# Service worker
ENABLE_SW=true

# LOCAL DEVELOPMENT ONLY. Shows a permanent warning banner and is intended for
# use against the contract mock in tests/. MUST be false in production.
CONTRACT_PREVIEW=false

# Build identifier used for cache versioning (set by CI).
BUILD_ID=local
