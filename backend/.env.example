# ==============================================================
# STARMOND TECHNOLOGY LIMITED — backend environment template
# Copy to .env and fill in. NEVER commit real secrets.
# ==============================================================

# ---------------- Django ----------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_TIME_ZONE=Africa/Lagos
DJANGO_LOG_LEVEL=INFO
SITE_URL=https://www.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
FRONTEND_BASE_URL=https://www.yourdomain.com

# ---------------- Database (MySQL 8+) ----------------
DB_ENGINE=mysql
DB_NAME=starmond
DB_USER=starmond
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60
# For local dev/testing without MySQL only:
# DB_ENGINE=sqlite

# ---------------- Paystack ----------------
# Test keys: pk_test_.../sk_test_...  Live keys: pk_live_.../sk_live_...
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=NGN
# Optional. Leave unset in production (defaults to https://api.paystack.co).
# Only point this elsewhere for local end-to-end tests (tests/e2e/mock_paystack.py).
# PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack sends the customer back after paying. Defaults to
# <FRONTEND_BASE_URL>/payment-pending.html, which is what the storefront expects.
# PAYSTACK_CALLBACK_URL=https://www.yourdomain.com/payment-pending.html

# ---------------- Backblaze B2 (S3-compatible) ----------------
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=starmond-media
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PUBLIC_BASE_URL=https://cdn.yourdomain.com
B2_MEDIA_PRIVATE_BUCKET=starmond-media-private

# ---------------- Email (any provider via Django email backend) ----------------
# SMTP example (Brevo/Mailgun/SendGrid/Postmark/SES all provide SMTP relays).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-login@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=STARMOND TECHNOLOGY LIMITED <no-reply@yourdomain.com>
EMAIL_MAX_AUTO_ATTEMPTS=4

# ---------------- Redis / Celery ----------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---------------- Security & frontend integration ----------------
CORS_ALLOWED_ORIGINS=https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com
# The site origin the browser shows MUST be listed in CSRF_TRUSTED_ORIGINS, even
# when the frontend reverse-proxies /api/ on the same domain; otherwise every
# form submission is rejected with "CSRF Failed: Origin checking failed".
#
# Cookies. Same domain (recommended: frontend proxies /api/ and /media/):
#   keep the defaults below.
# Frontend and API on different sites: set both SAMESITE values to None
#   (cookies are then sent cross-site and must be Secure, i.e. HTTPS only).
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Optional: share cookies across sub-domains, e.g. .yourdomain.com
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# ---------------- Business rules ----------------
INVENTORY_RESERVATION_MINUTES=30
PENDING_ORDER_EXPIRY_MINUTES=60
MAX_CATEGORY_DEPTH=3
MAX_CART_ITEMS=50
MAX_CART_ITEM_QUANTITY=100
MAX_UPLOAD_SIZE_MB=8
GUEST_ORDER_LINK_EXPIRY_DAYS=30

# ---------------- Throttling ----------------
THROTTLE_ANON=240/hour
THROTTLE_USER=1200/hour
THROTTLE_AUTH=10/hour
THROTTLE_WEBHOOK=600/minute
