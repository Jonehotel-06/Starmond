# =============================================================================
# STARMOND TECHNOLOGY LIMITED — backend environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Django core -------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-50-plus-character-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.starmond.com
DJANGO_SETTINGS_MODULE=config.settings.development
TIME_ZONE=Africa/Lagos

# --- Business identity -------------------------------------------------------
BUSINESS_NAME=STARMOND TECHNOLOGY LIMITED
SITE_URL=https://starmond.com
FRONTEND_URL=https://starmond.com
DEFAULT_CURRENCY=NGN
SUPPORTED_CURRENCIES=NGN

# --- Database ----------------------------------------------------------------
# sqlite (local development) | postgres | mysql
DB_ENGINE=sqlite
DB_NAME=starmond
DB_USER=starmond
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Paystack ----------------------------------------------------------------
# PAYSTACK_MODE must be "test" during development. The application refuses to
# run live credentials unless PAYSTACK_MODE=live and DEBUG=False.
PAYSTACK_MODE=test
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://starmond.com/checkout/callback
PAYSTACK_TIMEOUT_SECONDS=20
PAYSTACK_MAX_RETRIES=3
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer,qr
PAYSTACK_ALLOW_LIVE_IN_DEBUG=False

# --- Email -------------------------------------------------------------------
# Development: django.core.mail.backends.console.EmailBackend
# Production : django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@starmond.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=STARMOND <no-reply@starmond.com>
SERVER_EMAIL=STARMOND <no-reply@starmond.com>
EMAIL_FAIL_SILENTLY=True

# --- Static & media ----------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=/var/www/starmond/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/starmond/media
MAX_UPLOAD_SIZE_BYTES=8388608

# Operational guard on category nesting (the taxonomy itself is unlimited).
MAX_CATEGORY_DEPTH=25

# --- Security / CORS / CSRF --------------------------------------------------
CORS_ALLOWED_ORIGINS=https://starmond.com,https://www.starmond.com
CSRF_TRUSTED_ORIGINS=https://starmond.com,https://www.starmond.com
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- JWT ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=45
JWT_REFRESH_DAYS=14

# --- Business rules (Section 45) --------------------------------------------
ORDER_EXPIRY_MINUTES=60
STOCK_RESERVATION_MINUTES=60
LOW_STOCK_DEFAULT_THRESHOLD=5
MAX_CART_ITEM_QUANTITY=50
MAX_CART_LINES=50
MAX_DISCOUNT_PERCENTAGE=100
REVIEW_EDIT_WINDOW_DAYS=30
REFUND_MAX_DAYS_AFTER_DELIVERY=30
IDEMPOTENCY_KEY_TTL_HOURS=24

# --- API throttling ----------------------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_CHECKOUT=30/min
THROTTLE_REVIEW=5/hour
THROTTLE_WEBHOOK=600/min
THROTTLE_SEARCH=120/min
API_PAGE_SIZE=20

# --- Cache / throttling ------------------------------------------------------
# Leave empty for per-process LocMemCache (single worker only).
# Set to e.g. redis://127.0.0.1:6379/1 in production so throttle counters and
# cached settings are shared across all workers.
REDIS_URL=
CACHE_TIMEOUT=300

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
